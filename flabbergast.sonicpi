#-- Sonic Pi Set v1
#-- meta {"current":6,"zooms":[2,2,2,2,2,2,2,2,2,2]}
#-- buffer 0
# Coded by Sam Aaron

use_synth :hollow
use_random_seed 3
use_debug false
this_amp = 0
with_fx :reverb do
  with_fx(:echo, delay: 0.5, decay: 4) do
    live_loop :echoes do
      play chord([:b1, :b2, :e1, :e2, :b3, :e3].choose, :minor).choose, cutoff: rrand(40, 100), amp: this_amp, attack: 0, release: rrand(1, 2), cutoff_max: 110
      sleep [0.25, 0.5, 0.5, 0.5, 1, 1].choose
    end
  end
end

#-- buffer 1
# Coded by Sam Aaron

with_fx :reverb, mix: 0.5 do
  live_loop :oceans do
    s = synth [:bnoise, :cnoise, :gnoise].choose, amp: rrand(0.1, 0.5), attack: rrand(0, 4), sustain: rrand(0, 2), release: rrand(1, 5), cutoff_slide: rrand(0, 5), cutoff: rrand(60, 100), pan: rrand(-1, 1), pan_slide: rrand(1, 5), amp: rrand(0, 0)
    control s, pan: rrand(-1, 1), cutoff: rrand(60, 110)
    sleep rrand(2, 4)
  end
end

#-- buffer 2
# Conch Trumpet / Horn Sound Synthesis for Sonic Pi
use_tuning :just

live_loop :conch_trumpet do
  # Frequency parameters (D2 ~ 146.83 Hz / MIDI note 38)
  note_num = 60
  dur = rrand(4, 6)
  
  use_synth_defaults sustain: dur * 0.8, release: dur * 0.5, amp: 0
  
  # Dynamic pitch stabilization & vibrato sub-loop running concurrently
  in_thread do
    tick
    # Pitch bend initialization and vibrato modulation
    with_fx :tremolo, depth: rrand(0.25, 1), rate: 35 do
      # Oscillator 1: Primary Sawtooth
      synth :saw, note: note_num - 0.03, cutoff: rrand(10, 85), note_slide: 0.4
      
      # Oscillator 2: Detuned Sawtooth for thickness
      synth :supersaw, note: note_num + 0.03, cutoff: rrand(20,85), note_slide: 0.4
      
      # Oscillator 3: Narrow Pulse for reed/conch resonance
      synth :pulse, note: note_num, pulse_width: 0.45, cutoff: rrand(20, 80), note_slide: 0.4
    end
  end
  
  # Low-pass filter automation mimicking the horn enclosure
  with_fx :lpf, cutoff: rrand(20, 88), cutoff_slide: dur do |f|
    control f, cutoff: rrand(20, 70)
  end
  
  # Warm room reverb matching natural shell acoustic
  with_fx :reverb, room: 0.86, mix: 0.71 do
    sleep dur + 0.5
  end
end
#-- buffer 3
# Coded by Sam Aaron
load_sample :drum_heavy_kick
amp_amount = 0
dur = 10
in_thread do
  live_loop :drums do
    sample :bd_mehackit, amp: amp_amount
    sleep 1
  end
end
in_thread do
  live_loop :snare do
    sample :sn_dolf, amp: amp_amount
    sleep 2
    play 30
    sleep 2
  end
  
  live_loop :hats do
    sample :hat_snap, amp: amp_amount
    play 37
    sleep 1
  end
end
in_thread do
  live_loop :ohats do
    sample :hat_zild, amp: amp_amount
    sleep 4
    play 37
  end
end
#-- buffer 4
# Steve Reich's Piano Phase
# See: https://en.wikipedia.org/wiki/Piano_Phase
use_tuning :just

notes = (ring :E4, :Fs4, :E4, :Cs5, :E5, :Fs4, :E4, :Cs5, :B4, :Fs4, :D5, :Cs5)
with_fx :reverb do
  live_loop :slow do
    sample :ambi_piano
    
    play notes.tick, release: 2, rate: rrand(-2, 5),  amp: 0
    sleep rrand(0.3, 3)
  end
end


#-- buffer 5
use_bpm 20
this_amp = rrand(0,0)

# Reverb and low-pass filtering simulate outdoor atmospheric density
with_fx :reverb, room: 0.85, mix: 1, damp: 0.5 do
  
  # --------------------------------------------------
  # 1. DENSE RAIN WALL (Continuous Heavy Downpour)
  # --------------------------------------------------
  live_loop :rain_wall do
    use_synth :bnoise
    
    # Dual-filter stack shapes white noise into a roaring wall of water
    with_fx :lpf, cutoff: rrand(75, 90) do
      with_fx :hpf, cutoff: 35 do
        play :c3, attack: 0.5, sustain: 2, release: 0.5, amp: this_amp
      end
    end
    sleep 2.5
  end
  
  # --------------------------------------------------
  # 2. DROP IMPACTS (Heavy Drops Striking Surfaces)
  # --------------------------------------------------
  live_loop :heavy_drops do
    use_synth :sine
    
    # Fast micro-bursts of pitch-dropping sine waves mimic distinct drops
    8.times do
      drop_pitch = rrand(60, 85)
      
      node = play drop_pitch,
        attack: 0.001,
        release: rrand(0.02, 0.05),
        amp: this_amp,
        pan: rrand(-0.8, 0.8)
      
      # Rapid downward pitch-bend simulates liquid impact
      control node, note: drop_pitch - 12, note_slide: 0.01
      
      sleep [0.0625, 0.125, 0.1875].choose
    end
  end
  
  # --------------------------------------------------
  # 3. HIGH SPLASH & SPRAY (Misting Noise Layer)
  # --------------------------------------------------
  live_loop :splash_spray do
    use_synth :cnoise
    
    # High-pass filter isolates the crisp, sizzle quality of heavy splashing
    with_fx :hpf, cutoff: 85 do
      play :c4, attack: 0.2, sustain: 1, release: 0.3, amp: this_amp
    end
    sleep 1.25
  end
  
  # --------------------------------------------------
  # 4. WATER SURGES (Dynamic Downpour Swells)
  # --------------------------------------------------
  live_loop :rain_surge do
    # Periodic swells simulate sudden torrential bursts
    sleep rrand(4, 8)
    
    use_synth :pnoise
    surge_time = rrand(2, 4)
    
    with_fx :lpf, cutoff: rrand(80, 105) do
      play :c2, attack: surge_time * 0.5, release: surge_time * 0.5, amp: this_amp
    end
  end
  
end
#-- buffer 6
# Set global reverb and delay to simulate underwater reverberation
with_fx :reverb, mix: 0.8, room: 0.9 do
  with_fx :echo, phase: 0.75, decay: 8, mix: 0.5 do
    
    live_loop :whale_song do
      use_synth :prophet
      
      # Pick random whale-like pitches (low register, wide intervals)
      start_note = [:c2, :eb2, :f2, :g2, :bb2, :c3].choose
      end_note   = [:c2, :eb2, :f2, :g2, :bb2, :c3].choose
      
      # Randomize call duration and glide timing
      duration = rrand(4, 20)
      
      # Filter sweep to mimic sound traveling through deep water
      with_fx :lpf, cutoff: rrand(50, 85) do
        
        # Trigger the initial note
        node = play start_note,
          attack: duration * 0.3,
          decay: 0,
          sustain: duration * 0.4,
          release: duration * 0.3,
          amp: 0
        
        # Smoothly slide pitch mid-note (the signature whale "cry")
        control node, note: end_note, note_slide: duration * 0.6
        
      end
      
      # Natural pause between whale calls
      sleep duration + rrand(1, 4)
    end
    
  end
end
