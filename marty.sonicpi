#-- Sonic Pi Set v1
#-- meta {"current":1,"zooms":[3,2,2,2,2,2,2,2,2,2]}
#-- buffer 0
live_loop :lead do
  use_synth :piano
  use_tuning :just
  n = (scale :d3, :bayati).choose
  
  play n, release: 2.5, amp: 1.52
  sleep 1
  play :e4, release: 2.5, amp: 1.13
  sleep 1
  play :g4, release: 2.5, amp: 1.11
  sleep 1
  play :b4, release: 2.5, amp: 0.81
  play :e3, release: 2.5, amp: 1.15
  
  with_fx :echo, phase: 0.25, decay: 6 do
    play :e5, release: 0.1
  end
end
#-- buffer 1

live_loop :fred do
  sample :bd_haus, lpf: 80, amp: 0
  sleep 1
  sample :sn_dolf, hpf: 110, amp: 0
  sleep 1
end


#-- buffer 2
live_loop :chords do
  use_tuning :just
  use_synth :prophet
  c = (chord :e4, :sus4)
  play c, release: 3, cutoff: rrand(70, 130), amp: 1
  sleep 1
end
#-- buffer 3
use_random_seed 40
live_loop :freshest do
  sample :hat_cab, onset: pick,amp:0
  sleep 0.5
end
#-- buffer 4
use_random_seed 50
use_tuning :just
live_loop :harmo do
  sample :guit_em9, onset: pick, amp: 1
  sleep 2
end
#-- buffer 5

live_loop :groove do
  sample :bd_haus, amp:0
  sleep 1
  sample :sn_dolf, amp:0
  sleep 0.5
end



#-- buffer 6
live_loop :flibble do
  sample :ambi_choir, rate: 0.3
  sleep 1
end
